# Supabase Dashboard > Connect から取得します。
# ブラウザへ公開してよい Publishable Key のみを設定してください。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# public: 従来どおり自己Sign up可能
# invite_only: 全アプリ画面を認証必須にし、自己Sign upを無効化
AUTH_ACCESS_MODE=public

# ProductionではAuthメールの戻り先として公開URLを設定してください。
# ローカル開発では未設定でもリクエストのOriginを使用します。
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
